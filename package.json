{
  "name": "yarapa-code-standard",
  "private": true,
  "description": "YARAPA monorepo for the eslint-config-yarapa public ESLint Flat Config package.",
  "type": "module",
  "scripts": {
    "audit": "turbo run audit",
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status --since main",
    "check:attw": "turbo run check:attw",
    "check:doctor": "node packages/eslint-config-yarapa/scripts/doctor/doctor.mts",
    "check:publint": "turbo run check:publint",
    "check:verify-tarball": "node packages/eslint-config-yarapa/scripts/verify-tarball/verify-tarball.mts",
    "check-types": "pnpm typecheck",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "clean:dist": "turbo run clean:dist",
    "clean:test": "turbo run clean:test",
    "dev": "turbo run dev",
    "format": "prettier --write --cache . && turbo run format",
    "format:check": "prettier --check --cache . && turbo run format:check",
    "inspect": "pnpm build && eslint-config-inspector",
    "knip": "knip",
    "lint": "pnpm build && eslint . --fix --cache --max-warnings=0",
    "lint:check": "pnpm build && eslint . --cache --max-warnings=0",
    "prepare": "husky",
    "sort-package-json": "sort-package-json package.json && turbo run sort-package-json",
    "sort-package-json:check": "sort-package-json --check package.json && turbo run sort-package-json:check",
    "test": "turbo run test",
    "test:consumer": "turbo run test:consumer",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm --filter eslint-config-yarapa verify",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/config-inspector": "3.3.0",
    "eslint": "10.9.1",
    "husky": "9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "17.4.1",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.15.0"
  }
}
