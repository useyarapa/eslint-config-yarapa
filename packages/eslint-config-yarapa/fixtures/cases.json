[
  {
    "preset": "recommended",
    "compose": ["recommended"],
    "valid": {
      "filename": "fixtures/valid/recommended/case.js",
      "code": "export const value = \"ok\";\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/recommended/case.js",
      "code": "export const value = 'bad';\n",
      "rule": "@stylistic/quotes"
    }
  },
  {
    "preset": "base",
    "compose": ["base"],
    "valid": {
      "filename": "fixtures/valid/base/case.js",
      "code": "export const value = 1;\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/base/case.js",
      "code": "const unused = 1;\n",
      "rule": "unused-imports/no-unused-vars"
    }
  },
  {
    "preset": "typescript",
    "compose": ["typescript"],
    "valid": {
      "filename": "fixtures/valid/typescript/case.ts",
      "code": "export const value: string = \"ok\";\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/typescript/case.ts",
      "code": "export const value: any = 1;\n",
      "rule": "@typescript-eslint/no-explicit-any"
    }
  },
  {
    "preset": "typeChecked",
    "special": "typed-project"
  },
  {
    "preset": "disableTypeChecked",
    "special": "tooling-out-of-project"
  },
  {
    "preset": "node",
    "compose": ["base", "node"],
    "valid": {
      "filename": "fixtures/valid/node/case.js",
      "code": "export const cwd = process.cwd();\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/node/case.js",
      "code": "export const href = window.location.href;\n",
      "rule": "no-undef"
    }
  },
  {
    "preset": "browser",
    "compose": ["base", "browser"],
    "valid": {
      "filename": "fixtures/valid/browser/case.js",
      "code": "export const href = window.location.href;\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/browser/case.js",
      "code": "export const cwd = process.cwd();\n",
      "rule": "no-undef"
    }
  },
  {
    "preset": "stylistic",
    "compose": ["stylistic"],
    "valid": {
      "filename": "fixtures/valid/stylistic/case.js",
      "code": "export const value = \"ok\";\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/stylistic/case.js",
      "code": "export const value = 'bad'\n",
      "rule": "@stylistic/quotes"
    }
  },
  {
    "preset": "ignores",
    "special": "ignores"
  },
  {
    "preset": "security",
    "compose": ["security"],
    "valid": {
      "filename": "fixtures/valid/security/case.js",
      "code": "const record = { safe: 1 };\nexport const value = record.safe;\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/security/case.js",
      "code": "const record = { safe: 1 };\nconst key = \"safe\";\nexport const value = record[key];\n",
      "rule": "security/detect-object-injection"
    }
  },
  {
    "preset": "testingLibrary",
    "compose": ["testingLibrary"],
    "valid": {
      "filename": "fixtures/valid/testingLibrary/case.test.js",
      "code": "import { screen } from \"@testing-library/dom\";\nscreen.getByRole(\"button\");\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/testingLibrary/case.test.js",
      "code": "import { render } from \"@testing-library/dom\";\nconst { container } = render(\"<button />\");\ncontainer.querySelector(\"button\");\n",
      "rule": "testing-library/no-node-access"
    }
  },
  {
    "preset": "vitest",
    "compose": ["vitest"],
    "valid": {
      "filename": "fixtures/valid/vitest/case.test.js",
      "code": "import { expect, test } from \"vitest\";\ntest(\"works\", () => {\n  expect(1).toBe(1);\n});\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/vitest/case.test.js",
      "code": "import { test } from \"vitest\";\ntest.only(\"focused\", () => {});\n",
      "rule": "vitest/no-focused-tests"
    }
  },
  {
    "preset": "ava",
    "compose": ["ava"],
    "valid": {
      "filename": "fixtures/valid/ava/case.test.js",
      "code": "import test from \"ava\";\ntest(\"works\", t => {\n  t.is(1, 1);\n});\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/ava/case.test.js",
      "code": "import test from \"ava\";\ntest.only(\"focused\", t => {\n  t.is(1, 1);\n});\n",
      "rule": "ava/no-only-test"
    }
  },
  {
    "preset": "json",
    "compose": ["json"],
    "valid": {
      "filename": "fixtures/valid/json/case.json",
      "code": "{ \"value\": 1 }\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/json/case.json",
      "code": "{ \"value\": 1, }\n",
      "rule": "jsonc/comma-dangle"
    }
  },
  {
    "preset": "packageJson",
    "compose": ["packageJson"],
    "valid": {
      "filename": "fixtures/valid/packageJson/package.json",
      "code": "{\n  \"name\": \"fixture-package\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Fixture package.\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/example/fixture-package.git\"\n  },\n  \"license\": \"MIT\",\n  \"author\": \"YARAPA\",\n  \"sideEffects\": false,\n  \"type\": \"module\",\n  \"exports\": \"./index.js\",\n  \"files\": [\n    \"index.js\"\n  ]\n}\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/packageJson/package.json",
      "code": "{\n  \"name\": \"Bad Package Name\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Fixture package.\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/example/fixture-package.git\"\n  },\n  \"license\": \"MIT\",\n  \"author\": \"YARAPA\",\n  \"sideEffects\": false,\n  \"type\": \"module\",\n  \"exports\": \"./index.js\",\n  \"files\": [\n    \"index.js\"\n  ]\n}\n",
      "rule": "package-json/valid-name"
    }
  },
  {
    "preset": "jsdoc",
    "compose": ["jsdoc"],
    "valid": {
      "filename": "fixtures/valid/jsdoc/case.js",
      "code": "/**\n * Greets a name.\n * @param {string} name - Name to return.\n * @returns {string} The provided name.\n */\nexport function greet(name) {\n  return name;\n}\n"
    },
    "invalid": {
      "filename": "fixtures/invalid/jsdoc/case.js",
      "code": "/**\n * Greets a name.\n * @param {string} wrong - Name to return.\n * @returns {string} The provided name.\n */\nexport function greet(name) {\n  return name;\n}\n",
      "rule": "jsdoc/check-param-names"
    }
  }
]
